# Copy to .env.local for local development.

# Where the AeroPulse API runs (the Python app in the repo root: `aeropulse serve`).
NEXT_PUBLIC_AEROPULSE_API_URL=http://127.0.0.1:8000

# This site's public address, used for canonical links, the sitemap and embed code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. A shared secret that lets this site's server skip the API's per-IP rate limit.
# Set the same value as AEROPULSE_SITE_KEY on the API. Server-only: never prefix it with NEXT_PUBLIC_.
AEROPULSE_SITE_KEY=
