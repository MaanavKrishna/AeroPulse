{$SITE_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# The API and its files are served by the Python app; every other path is the website.
	@api path /v1/* /downloads/* /csv/* /img/* /feeds/* /healthz
	handle @api {
		reverse_proxy app:8000
	}
	handle {
		reverse_proxy web:3000
	}
}
