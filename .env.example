# Copy to .env and fill in. Never commit .env.

# development | production | test. Production refuses the demo provider.
AEROPULSE_ENV=development

# SQLite for development; Postgres in production, e.g.
# postgresql+psycopg://aeropulse:CHANGE_ME@db:5432/aeropulse
AEROPULSE_DATABASE_URL=sqlite:///./aeropulse.db

# Public URL, used in citations, feeds and the sitemap.
AEROPULSE_SITE_URL=http://localhost:8000

# Providers to collect from, in priority order. The first one feeds the index.
# Use "demo" for synthetic data during development.
AEROPULSE_PROVIDERS=ignav

# Provider credentials.
AEROPULSE_IGNAV_API_KEY=
AEROPULSE_TRAVELPAYOUTS_TOKEN=

# Hard cap on billable calls per provider per day.
AEROPULSE_MAX_CALLS_PER_DAY=200

# Only for a private trial before provider terms are reviewed. Shows a notice on the site.
AEROPULSE_ALLOW_UNREVIEWED_TERMS=false

# Enables POST /v1/admin/rebuild. Leave empty to disable admin endpoints.
AEROPULSE_ADMIN_TOKEN=

# Public API requests per minute per client.
AEROPULSE_RATE_LIMIT=120
